# --- Poseidon environment contract (docs/architecture/07-infrastructure.md §6) ---
DEPLOY_MODE=local
DATABASE_URL=postgresql+psycopg://poseidon:poseidon@localhost:5432/poseidon
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=poseidon-artifacts
# Static creds for the local MinIO container only (matches docker-compose.yml's
# MINIO_ROOT_USER/PASSWORD); optional — SPCS/EC2 never set these (07 §6).
S3_ACCESS_KEY=poseidon
S3_SECRET_KEY=poseidon123
DATA_BACKEND=synthetic
IDENTITY_MODE=disabled
# AUTH0_DOMAIN=your-tenant.us.auth0.com   (required when IDENTITY_MODE=auth0)
# AUTH0_AUDIENCE=https://poseidon/api
# AUTH0_CLIENT_ID=...
# CHAT_MODE selects which chat HTTP surface the backend mounts (defaults to
# "mock" below if unset -- final-review wave, I-2: previously documented
# nowhere, which let the frontend and a bare `uvicorn` run drift apart).
#   mock - an in-memory scripted demo chat with canned responses; no
#          database or LLM calls required. The safe default for a fresh
#          checkout, but its envelope is for demo purposes only.
#   live - the real execute_turn pipeline (real skills, Postgres-backed
#          history, real LLM calls per LLM_MODE); what the frontend needs
#          for actual end-to-end use. docker-compose.yml sets this for you.
CHAT_MODE=mock
LLM_PROFILE=bedrock
LLM_MODE=stub
TOOL_TRANSPORT_PERPLEXITY=direct
# PERPLEXITY_API_KEY=...
MEMORY_MAX_CHARS=8000
MEMORY_KEEP_VERSIONS=20
# STATIC_DIR points at a directory of BUILT SPA assets (a Vite `dist`) that the
# backend then serves from "/" -- the single-origin production shape. Leave it
# UNSET for local development: Vite's dev server serves the frontend on :5173
# and proxies /api to :8000 (frontend/vite.config.ts), which is what gives hot
# module reload. Set only in a container image that actually carries a build
# (infra/docker-compose.ec2.yml sets STATIC_DIR=/app/static).
# STATIC_DIR=/app/static

# --- EC2 -------------------------------------------------------------------
# This file is the LOCAL developer contract. An EC2 box uses none of it: the
# environment there is split in two by infra/docker-compose.ec2.yml.
#
# 1. Non-secret shape, baked into the compose file itself and readable in git:
#      DEPLOY_MODE=ec2   DATA_BACKEND=synthetic   IDENTITY_MODE=auth0
#      LLM_PROFILE=bedrock   LLM_MODE=live   CHAT_MODE=live (backend only)
#      STATIC_DIR=/app/static   TOOL_TRANSPORT_PERPLEXITY=direct
#      POSEIDON_ENV_FILE=""
#
# 2. Everything environment-specific or secret, in /etc/poseidon/backend.env
#    -- authored ON THE BOX, root-owned and mode 0600, never in git and never
#    generated by any tooling in this repo. Compose only ever references it by
#    path. Placeholder shape (values are illustrative, not real):
#
#      DATABASE_URL=postgresql+psycopg://poseidon:<password>@<rds-endpoint>:5432/poseidon
#      AUTH0_DOMAIN=your-tenant.us.auth0.com
#      AUTH0_AUDIENCE=https://poseidon/api
#      AUTH0_CLIENT_ID=<spa-client-id>
#      S3_BUCKET=poseidon-artifacts-<account>
#      PERPLEXITY_API_KEY=<optional; omit to run without live web research>
#
# NO AWS KEYS ANYWHERE, on purpose. S3_ENDPOINT_URL / S3_ACCESS_KEY /
# S3_SECRET_KEY are left UNSET on EC2 (they exist for the local MinIO stack
# only): unset, ArtifactStore talks to real S3 and boto3 authenticates through
# the instance profile attached to the EC2 instance. Bedrock resolves through
# that same instance profile. The box therefore holds no long-lived AWS
# credential to leak or rotate.
#
# The frontend's Auth0 values are NOT runtime environment on EC2 either --
# Vite inlines VITE_AUTH0_DOMAIN / VITE_AUTH0_CLIENT_ID / VITE_AUTH0_AUDIENCE
# into the bundle at BUILD time, so they are `--build-arg`s to
# infra/Dockerfile, not entries in the env file above.

# --- Not yet implemented ---------------------------------------------------
# The variables above are the Phase-0 subset of the doc 07 §6 contract — what
# Settings reads today. The rest arrive with the phases that own them, and are
# ignored (extra="ignore") until then:
#   SNOWFLAKE_*                              — Snowflake data backend (Phases 3/5)
#   LLM_PROVIDER_<ROLE> / LLM_MODEL_<ROLE>   — per-role model routing (Phase 13)
#   MEMORY_IDLE_MINUTES / MEMORY_MAX_ATTEMPTS,
#   RETENTION_* , BACKUP_*                   — deploy phases
#
# POSEIDON_ENV_FILE selects which dotenv Settings reads (default ".env").
# Set it to "" to read none — Docker Compose does this so a host .env cannot
# shadow the container environment.
