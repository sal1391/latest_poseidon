# ============================================================
# Copy this file to .env and fill in your real values
# ============================================================

# Deployment mode: "local" or "aws"
DEPLOY_MODE=local
AUTH0_ENABLED=false

# Snowflake credentials (required for local mode)
SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=SANDBOX
SNOWFLAKE_SCHEMA=MCA
SNOWFLAKE_ROLE=your-role

# Perplexity API key
PERPLEXITY_API_KEY=pplx-xxxx

# AWS / Auth0 (only needed when DEPLOY_MODE=aws)
AWS_REGION=us-east-1
BITBUCKET_DEPLOYMENT_ENVIRONMENT=dev
CLIENTID=your-auth0-client-id
DOMAIN=your-auth0-domain
